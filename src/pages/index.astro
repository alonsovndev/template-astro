---
import PageLayout from "../layouts/PageLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PricingSelector from "../features/pricing/PricingSelector";
import { siteContent } from "../config/site";
---

<PageLayout title={siteContent.title}>
  <Header />
  <main id="main" tabindex="-1">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">{siteContent.hero.eyebrow}</p>
        <h1 id="hero-title">{siteContent.hero.title}</h1>
        <p class="hero-description">{siteContent.hero.description}</p>
        <div class="hero-actions">
          <a class="button" href={siteContent.hero.primaryAction.href}>
            {siteContent.hero.primaryAction.label} <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href={siteContent.hero.secondaryAction.href}>
            {siteContent.hero.secondaryAction.label} <span aria-hidden="true">↓</span>
          </a>
        </div>
        <p class="hero-note">{siteContent.hero.note}</p>
      </div>
      <img
        class="hero-art"
        src={siteContent.artwork.hero.src}
        alt={siteContent.artwork.hero.alt}
        width="640"
        height="560"
        fetchpriority="high"
      />
    </section>
    <section id="features" class="section container" aria-labelledby="features-title">
      <div class="section-heading">
        <p class="eyebrow">{siteContent.sections.features.eyebrow}</p>
        <h2 id="features-title">{siteContent.sections.features.title}</h2>
        <p>{siteContent.sections.features.description}</p>
      </div>
      <div class="feature-grid">
        {siteContent.features.map((feature) => (
          <article class="feature-card">
            <span class="feature-label">{feature.label}</span>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </article>
        ))}
      </div>
    </section>
    <section id="pricing" class="section pricing-section" aria-labelledby="pricing-title">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">{siteContent.sections.pricing.eyebrow}</p>
          <h2 id="pricing-title">{siteContent.sections.pricing.title}</h2>
          <p>{siteContent.sections.pricing.description}</p>
        </div>
        <PricingSelector
          plans={siteContent.plans}
          contactEmail={siteContent.contactEmail}
          disclaimer={siteContent.sections.pricing.disclaimer}
          client:visible
        />
      </div>
    </section>
    <section id="faq" class="section container faq-section" aria-labelledby="faq-title">
      <div class="section-heading">
        <p class="eyebrow">{siteContent.sections.faq.eyebrow}</p>
        <h2 id="faq-title">{siteContent.sections.faq.title}</h2>
      </div>
      <div class="faq-list">
        {siteContent.questions.map((question) => (
          <details>
            <summary>
              {question.question}
              <span aria-hidden="true">+</span>
            </summary>
            <p>{question.answer}</p>
          </details>
        ))}
      </div>
    </section>
    <section id="contact" class="contact-section container" aria-labelledby="contact-title">
      <div>
        <p class="eyebrow">{siteContent.sections.contact.eyebrow}</p>
        <h2 id="contact-title">{siteContent.sections.contact.title}</h2>
      </div>
      <a class="button button-light" href={`mailto:${siteContent.contactEmail}`}>
        {siteContent.contactLabel} <span aria-hidden="true">↗</span>
      </a>
    </section>
  </main>
  <Footer />
</PageLayout>
