#!/usr/bin/env sh
subject=$(head -n 1 "$1")
case "$subject" in
  "Merge "*|"Revert "*) exit 0 ;;
esac
if ! printf '%s\n' "$subject" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?!?: .{1,100}$'; then
  echo "Commit subject must follow Conventional Commits: <type>[scope]: <description>" >&2
  exit 1
fi
